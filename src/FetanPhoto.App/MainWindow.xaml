<Window x:Class="FetanPhoto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fetan Photo"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="FETAN PHOTO"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrandRed}"/>
                <TextBlock Text="Professional Photo System"
                           FontSize="16"
                           Foreground="#666"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    CornerRadius="18"
                    Background="{StaticResource PanelBrush}"
                    Padding="14,8"
                    HorizontalAlignment="Right">
                <TextBlock x:Name="CameraStatusText"
                           Text="Camera: not connected"
                           FontSize="15"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid x:Name="HomePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Select photo type"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,28"/>
                <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="90,10">
                    <Button Content="Passport" Click="Passport_Click"/>
                    <Button Content="Visa" Click="Visa_Click"/>
                    <Button Content="ID Photo" Click="Id_Click"/>
                    <Button Content="3 × 4" Click="ThreeByFour_Click"/>
                    <Button Content="CV / Profile" Click="Cv_Click"/>
                    <Button Content="Custom" Click="Custom_Click"/>
                </UniformGrid>
            </Grid>

            <Grid x:Name="CapturePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#202020"
                        CornerRadius="14"
                        Margin="0,0,20,0">
                    <Grid>
                        <TextBlock Text="LIVE CAMERA PREVIEW"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Border Width="270"
                                Height="360"
                                BorderBrush="#99FFFFFF"
                                BorderThickness="2"
                                CornerRadius="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedPresetText"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="8,0,8,20"/>
                    <TextBlock Text="Position the customer inside the guide."
                               TextWrapping="Wrap"
                               FontSize="17"
                               Foreground="#555"
                               Margin="8,0,8,18"/>
                    <Button Content="CONNECT CAMERA"
                            Click="ConnectCamera_Click"/>
                    <Button Content="CAPTURE"
                            Background="{StaticResource BrandRed}"
                            Foreground="White"
                            Click="Capture_Click"/>
                    <Button Content="BACK"
                            Click="BackToHome_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ReviewPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EEE" CornerRadius="14" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ORIGINAL"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="20"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="Captured photo preview"
                                   HorizontalAlignment="Center"
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="35">
                    <TextBlock Text="PHOTO READY"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandRed}"
                               Margin="8,0,8,16"/>
                    <TextBlock Text="V1 review screen. Automatic face crop and print layout come next."
                               TextWrapping="Wrap"
                               FontSize="17"
                               Foreground="#555"
                               Margin="8,0,8,18"/>
                    <Button Content="RETAKE" Click="Retake_Click"/>
                    <Button Content="CONTINUE TO PRINT"
                            Background="{StaticResource BrandRed}"
                            Foreground="White"
                            Click="ContinueToPrint_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="PrintPanel" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <TextBlock Text="Print"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PrintSummaryText"
                               FontSize="19"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#555"
                               Margin="0,18"/>
                    <Border Height="230"
                            Background="#F0F0F0"
                            CornerRadius="12"
                            Margin="0,8,0,18">
                        <TextBlock Text="10 × 15 print layout preview"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#777"
                                   FontSize="18"/>
                    </Border>
                    <Button Content="PRINT (coming in milestone 3)"
                            IsEnabled="False"/>
                    <Button Content="NEW CUSTOMER"
                            Background="{StaticResource BrandRed}"
                            Foreground="White"
                            Click="NewCustomer_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="REDBOOTH • Fetan Photo V1"
                   Foreground="#888"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0"/>
    </Grid>
</Window>
